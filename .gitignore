# Secrets — never committed. Read from C:\Users\layiw\.env.private at use time.
.env
.env.*
*.key
*.pem

# Python bytecode and virtualenvs
__pycache__/
*.py[cod]
.venv/
venv/

# The VM work directory. Transcripts and receipts are BUILD OUTPUT regenerated by
# pipeline/, and the source media is deleted as each unit completes — there is
# nothing here that is not reproducible from the manifest.
run/
run2/
chain/
vault/

# Transient scratch used while scoping. The scripts that matter are tracked.
pipeline/scripts/_*.py
pipeline/scripts/_*.js

# OS noise
Thumbs.db
desktop.ini
.DS_Store
# ad-hoc agent scratch dirs (never evidence; findings live in the spec + evidence/)
.verify/
.scratch/


# subagent scratch (agents write here while running; findings go in stage-1/)
pipeline/out/_r*/

# --- beads recovery artifacts (never work, never commit) ---
# frankensqlite 0.4.4 leaves a dated quarantine point under .beads/quarantine/
# each time a WAL-index recovery fails. Three runs today produced ~3.3 MB.
# Untracked-by-default is right; ignoring it stops it masquerading as a change.
/.beads/quarantine/
/.beads/.br_recovery/
# vacuum lease files from failed/retried br operations
/.beads/.beads.vacuum.*
